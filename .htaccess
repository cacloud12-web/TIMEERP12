# TimeERP — Hostinger / Apache static hosting
# Production hardening. Does not change site UI.

Options -Indexes
DirectoryIndex index.html index.htm
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block private / tooling paths
  RewriteRule ^scripts(/|$) - [F,L]
  RewriteRule (?:^|/)\.git(?:/|$) - [F,L]
  RewriteRule (?:^|/)\.env(?:\.|$) - [F,L]
  RewriteRule ^agent-transcripts(/|$) - [F,L]
  RewriteRule ^timeerp[\s%20]+blog(/|$) - [F,L]
  RewriteRule ^api/demo-leads\.log$ - [F,L]

  # Force HTTPS in production (skip local preview)
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Book Demo deep link — /demo opens homepage with the booking modal
  RewriteRule ^demo/?$ /index.html [L]

  # Serve existing files/dirs as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Case-friendly redirects (Linux hosts are case-sensitive)
  RewriteRule ^our_presence\.html$ /Our_Presence.html [R=301,L,NC]
  RewriteRule ^our-presence\.html$ /Our_Presence.html [R=301,L,NC]
  RewriteRule ^real_estate\.html$ /real_Estate.html [R=301,L,NC]
  RewriteRule ^real-estate\.html$ /real_Estate.html [R=301,L,NC]
  RewriteRule ^ca\.html$ /CA.html [R=301,L,NC]
  RewriteRule ^academy\.html$ /Academy.html [R=301,L,NC]
  RewriteRule ^myservice\.html$ /MYservice.html [R=301,L,NC]
</IfModule>

# Prefer no-cache for HTML so updates go live quickly after deploy
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Shorter asset cache so nav/script fixes appear within a day without hard purge
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Gzip (Hostinger Apache)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# UTF-8 for text assets
AddDefaultCharset UTF-8
